{
  "name": "@bitsocial/mintpass",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "MintPass: paid, soulbound (ERC-5192), expiring passes priced in USD and paid in ETH via Chainlink",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fork": "FORK_TEST_RPC_URL=${FORK_TEST_RPC_URL:-${MAINNET_RPC_URL:-https://ethereum-rpc.publicnode.com}} hardhat test test/fork.mainnet.test.ts",
    "test:gas": "REPORT_GAS=1 hardhat test test/MintPass.test.ts",
    "gas": "hardhat run scripts/gas-report.ts",
    "coverage": "hardhat coverage --testfiles test/MintPass.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:fork": "FORK_URL=${FORK_URL:-${MAINNET_RPC_URL:-https://ethereum-rpc.publicnode.com}} hardhat run scripts/deploy.ts --network hardhat",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  }
}
