# Copy to .env (never commit it). Only DEPLOYER_PRIVATE_KEY is secret.

# Deployer key: only needed for a real (non dry-run) deploy.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints (defaults shown).
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Mainnet-fork test: set to run test/fork.mainnet.test.ts (skipped when unset).
# `yarn test:fork` sets it to MAINNET_RPC_URL or the publicnode default.
FORK_TEST_RPC_URL=

# Deploy script parameters.
DEPLOYMENT=5chan-pass          # 5chan-pass | seedit-gold
PAYOUT_ADDRESS=                # receives all proceeds; required
DRY_RUN=1                      # 1 = build, simulate and print only; 0 = send the tx

# Contract verification.
ETHERSCAN_API_KEY=
