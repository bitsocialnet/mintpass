{
  "name": "@bitsocial/mintpass-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "portless run --name mintpass vite",
    "dev": "yarn start",
    "build": "yarn typecheck && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin src vite.config.ts",
    "format": "oxfmt src scripts index.html 404.html vite.config.ts tsconfig.json package.json",
    "format:check": "oxfmt --check src scripts index.html 404.html vite.config.ts tsconfig.json package.json",
    "doctor": "react-doctor . -y",
    "agent:verify": "yarn lint && yarn format:check && yarn build && yarn doctor"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "@types/node": "22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "agentation": "3.0.2",
    "bippy": "0.7.3",
    "element-source": "0.0.5",
    "modern-web-guidance": "1.0.0",
    "oxfmt": "0.20.0",
    "oxlint": "1.56.0",
    "portless": "0.11.1",
    "react-doctor": "0.9.14",
    "typescript": "5.9.3",
    "vite": "8.1.6"
  },
  "resolutions": {
    "oxfmt/tinypool": "2.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.17.1"
}
